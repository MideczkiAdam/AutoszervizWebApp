@page
@model AutoszervizWebApp.Pages.JavitasPages.IndexModel
@using AutoszervizWebApp.Models

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<form method="get">
    <label for="allapot">Szűrés állapot szerint</label>
    <select id="allapot"
            name="KivalasztottAllapot"
            asp-for="KivalasztottAllapot"
            asp-items="Html.GetEnumSelectList<EAllapot>()"
            onchange="this.form.submit()">
            <option value="">-- Minden --</option>
    </select>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Javitas[0].Ugyfel.Nev)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Javitas[0].Rendszam)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Javitas[0].Leiras)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Javitas[0].Koltseg)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Javitas[0].Allapot)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Javitas[0].FelvetelDatuma)
            </th>
            <th>Állapot léptetése</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Javitas) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Ugyfel.Nev)
            </td>
            <td>
                @Html.DisplayFor(model => item.Rendszam)
            </td>
            <td>
                @Html.DisplayFor(model => item.Leiras)
            </td>
            <td>
                @Html.DisplayFor(model => item.Koltseg)
            </td>
            <td>
                @Html.DisplayFor(model => item.Allapot)
            </td>
            <td>
                @Html.DisplayFor(model => item.FelvetelDatuma)
            </td>
            <td>
                <form method="post" asp-page-handler="Allapot" asp-route-id="@item.Id">
                    <button type="submit">⏩</button>
                </form>
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
